{
  "name": "engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "home": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "cli": "tsx src/cli.ts",
    "check": "tsx src/cli.ts check ../tables",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "pnpm deploy --prod --legacy ../dist-deploy/engine"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "fastify": "^5.3.3",
    "@fastify/static": "^8.1.1",
    "mqtt": "^5.13.0",
    "pino": "^9.7.0",
    "pocketbase": "^0.26.1",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/suncalc": "^1.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}

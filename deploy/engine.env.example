# Copy to /etc/pioneer-home/engine.env on the Pi (root-owned, mode 640, group pi).
TABLES_DIR=/opt/pioneer-home/tables
STATE_DIR=/opt/pioneer-home/state
WEB_DIR=/opt/pioneer-home/web/dist
MQTT_URL=mqtt://localhost:1883
# Dry run: log every action, publish nothing. Keep true until Node-RED is cut over per area.
DRY_RUN=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
